# Supabase: Project Settings → Database → Connection pooling (dùng pooler vì kết nối trực tiếp chỉ có IPv6).
# Mật khẩu có ký tự đặc biệt (@, #, /…) phải mã hoá URL, vd @ → %40.
# Ứng dụng: chế độ transaction (cổng 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<mật-khẩu>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true
# Prisma migrate: chế độ session (cổng 5432)
DIRECT_URL=postgresql://postgres.<project-ref>:<mật-khẩu>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
# Hoặc Postgres cục bộ (docker compose --profile local-db up -d):
# DATABASE_URL=postgresql://truyen:truyen@localhost:5432/truyen


# Bảo vệ endpoint /api/cron/crawl (Vercel Cron gửi kèm tự động; cron-job.org thêm ?secret=…)
CRON_SECRET=change-me

# Ký URL proxy ảnh (/api/img). Đổi thành chuỗi ngẫu nhiên dài khi deploy.
IMAGE_PROXY_SECRET=change-me

# Better Auth — secret ngẫu nhiên dài, URL công khai của site
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# (Tuỳ chọn) Đăng nhập Google — bỏ trống để tắt
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mã xác minh Google Search Console (tuỳ chọn, phương thức "Thẻ HTML")
GOOGLE_SITE_VERIFICATION=

# Web Push — thông báo chương mới cho truyện đang theo dõi. Tạo khoá:
#   npx web-push generate-vapid-keys
# Khoá cố định: đổi khoá thì mọi người phải bật thông báo lại. Để trống thì tắt tính năng.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-domain.com

# URL công khai của site (dùng cho SEO, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tên site hiển thị
NEXT_PUBLIC_SITE_NAME=Kho Truyện

# (Tuỳ chọn) Proxy cho crawler, vd http://user:pass@host:port
# CRAWLER_PROXY=
