# Postgres + Redis (khớp với docker-compose.yml)
DATABASE_URL=postgresql://truyen:truyen@localhost:5432/truyen
REDIS_URL=redis://localhost:6379

# Ký URL proxy ảnh (/api/img). Đổi thành chuỗi ngẫu nhiên dài khi deploy.
IMAGE_PROXY_SECRET=change-me

# Better Auth — secret ngẫu nhiên dài, URL công khai của site
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# (Tuỳ chọn) Đăng nhập Google — bỏ trống để tắt
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL công khai của site (dùng cho SEO, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tên site hiển thị
NEXT_PUBLIC_SITE_NAME=Kho Truyện

# (Tuỳ chọn) Proxy cho crawler, vd http://user:pass@host:port
# CRAWLER_PROXY=
