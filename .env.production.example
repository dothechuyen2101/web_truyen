# Sao chép thành .env trên máy chủ và điền giá trị thật. KHÔNG commit file .env.

# --- CSDL: Supabase (Project Settings → Database → Connection pooling) ---
# Mật khẩu có ký tự đặc biệt phải mã hoá URL, vd @ → %40.
DATABASE_URL=postgresql://postgres.<project-ref>:<mật-khẩu>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true
DIRECT_URL=postgresql://postgres.<project-ref>:<mật-khẩu>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
# Lúc build image web cũng kết nối thẳng Supabase
BUILD_DATABASE_URL=postgresql://postgres.<project-ref>:<mật-khẩu>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true

# (Thay cho Supabase) Postgres chạy trên VPS — dùng --profile local-db:
# POSTGRES_USER=truyen
# POSTGRES_PASSWORD=doi-mat-khau-dai-ngau-nhien
# POSTGRES_DB=truyen
# DATABASE_URL=postgresql://truyen:<mật-khẩu>@postgres:5432/truyen
# BUILD_DATABASE_URL=postgresql://truyen:<mật-khẩu>@127.0.0.1:5432/truyen


# --- Bảo mật: tạo bằng `openssl rand -base64 32` ---
IMAGE_PROXY_SECRET=
BETTER_AUTH_SECRET=
CRON_SECRET=

# --- Site ---
SITE_DOMAIN=example.com
NEXT_PUBLIC_SITE_URL=https://example.com
BETTER_AUTH_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=Kho Truyện

# (Tuỳ chọn) Đăng nhập Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# (Tuỳ chọn) Proxy cho crawler, vd http://user:pass@host:port
# CRAWLER_PROXY=
