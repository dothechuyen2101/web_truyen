# Sao chép thành .env trên máy chủ và điền giá trị thật. KHÔNG commit file .env.

# --- Postgres (docker-compose.prod.yml) ---
POSTGRES_USER=truyen
POSTGRES_PASSWORD=doi-mat-khau-dai-ngau-nhien
POSTGRES_DB=truyen
# Ứng dụng kết nối qua mạng nội bộ Docker (tên service "postgres")
DATABASE_URL=postgresql://truyen:doi-mat-khau-dai-ngau-nhien@postgres:5432/truyen
# Lúc build image web (network: host) kết nối qua cổng mở cho máy chủ
BUILD_DATABASE_URL=postgresql://truyen:doi-mat-khau-dai-ngau-nhien@127.0.0.1:5432/truyen

REDIS_URL=redis://redis:6379

# --- Bảo mật: tạo bằng `openssl rand -base64 32` ---
IMAGE_PROXY_SECRET=
BETTER_AUTH_SECRET=

# --- Site ---
SITE_DOMAIN=example.com
NEXT_PUBLIC_SITE_URL=https://example.com
BETTER_AUTH_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=Kho Truyện

# (Tuỳ chọn) Đăng nhập Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# (Tuỳ chọn) Proxy cho crawler, vd http://user:pass@host:port
# CRAWLER_PROXY=
